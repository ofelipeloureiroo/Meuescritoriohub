{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role, subscription status and email",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "status": { "type": "string", "enum": ["active", "pending", "inactive"] },
        "createdAt": { "type": "string" },
        "subscriptionDueDate": { "type": "string" }
      },
      "required": ["uid", "email", "role", "status"]
    },
    "UserWorkspaceSection": {
      "title": "UserWorkspaceSection",
      "description": "Modular workspace section data (profile, projects, clients, contracts, finance)",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "string" },
        "version": { "type": "number" }
      }
    },
    "ClientPortalAccess": {
      "title": "ClientPortalAccess",
      "description": "Client individual portal access for tracking project stages, deadlines, documents, and messages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "officeUid": { "type": "string" },
        "clientName": { "type": "string" },
        "clientEmail": { "type": "string" },
        "accessCode": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "officeUid", "clientName", "clientEmail", "status"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Dedicated customer support conversation ticket between subscriber and platform administrator",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subscriberUid": { "type": "string" },
        "subscriberName": { "type": "string" },
        "subscriberEmail": { "type": "string" },
        "subscriberPhone": { "type": "string" },
        "status": { "type": "string", "enum": ["waiting_admin", "in_progress", "waiting_user", "resolved"] },
        "unreadByAdmin": { "type": "number" },
        "unreadByUser": { "type": "number" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string" },
        "lastMessageSender": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "sender": { "type": "string", "enum": ["user", "admin"] },
              "senderName": { "type": "string" },
              "senderEmail": { "type": "string" },
              "text": { "type": "string" },
              "time": { "type": "string" },
              "date": { "type": "string" },
              "timestamp": { "type": "string" },
              "read": { "type": "boolean" }
            }
          }
        }
      },
      "required": ["id", "subscriberEmail", "status", "messages"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User role and subscription document"
    },
    "/users/{userId}/data/{sectionId}": {
      "schema": "UserWorkspaceSection",
      "description": "User workspace section documents (profile, projects, clients, contracts, finance)"
    },
    "/clientPortals/{portalId}": {
      "schema": "ClientPortalAccess",
      "description": "Isolated client portal documents for clients to track their projects"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Real-time support ticket communication documents between subscribers and admin"
    }
  }
}
