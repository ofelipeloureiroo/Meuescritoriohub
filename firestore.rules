rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwnerEmail() {
      return isAuthenticated() && request.auth.token.email == 'lfquadrosdecorativos@gmail.com';
    }

    function isAdmin() {
      return isOwnerEmail() || (isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Connection test doc
    match /test/{testDoc} {
      allow read: if true;
    }

    // Absolute power to the owner across all documents
    match /{document=**} {
      allow read, write: if isOwnerEmail();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdmin() || 
        (resource != null && resource.data != null && resource.data.collaboratorUids != null && request.auth.uid in resource.data.collaboratorUids)
      );
      
      // Allow users to create their own profile
      // Regular users are enforced to be 'user' and 'pending'
      // The owner is allowed to be 'admin' and 'active'
      allow create: if isAuthenticated() 
                    && request.auth.uid == userId
                    && (
                      (request.resource.data.role == 'user' && request.resource.data.status == 'pending') ||
                      (isOwnerEmail() && request.resource.data.role == 'admin' && request.resource.data.status == 'active')
                    );
                    
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdmin() ||
        (resource != null && resource.data != null && resource.data.collaboratorUids != null && request.auth.uid in resource.data.collaboratorUids)
      );
      allow delete: if isAdmin();

      // Allow users and authorized collaborators to read and save workspace sections
      match /data/{sectionId} {
        allow read, write: if isAuthenticated() && (
          request.auth.uid == userId || 
          isAdmin() ||
          (exists(/databases/$(database)/documents/users/$(userId)) && 
           request.auth.uid in get(/databases/$(database)/documents/users/$(userId)).data.collaboratorUids)
        );
      }
    }
  }
}
